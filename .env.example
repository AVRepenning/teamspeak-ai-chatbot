# Example Environment Configuration for Jimmy TeamSpeak Voice Bot
# Rename this file to .env and insert your API keys / preferences.

# -------------------------------------------------------------
# 1. OpenRouter (Recommended: Fast, multi-model, low cost)
# -------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# -------------------------------------------------------------
# 2. Local LM Studio (100% Offline, Self-Hosted AI)
# -------------------------------------------------------------
# Start the local server in LM Studio on port 1234.
LM_STUDIO_URL=http://localhost:1234/v1

# -------------------------------------------------------------
# 3. OpenAI API (Optional: GPT-4o-mini & OpenAI TTS)
# -------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VOICE=fable

# -------------------------------------------------------------
# 4. Google Gemini API (Optional direct fallback)
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
